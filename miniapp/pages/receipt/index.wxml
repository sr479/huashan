<view class="page">
  <view wx:if="{{!booking}}" class="panel"><view class="title">查询你的预约回执</view><view class="store-line">请输入预约编号和预留手机号。</view><button class="primary wide spaced" bindtap="lookup">前往查询</button></view>
  <block wx:else>
    <view class="receipt-header"><view class="seal">✦</view><view class="title">{{booking.statusText}}</view><view class="small muted spaced">{{booking.status === 'pending' ? '申请已收到，店主确认后为你保留服装。' : '可刷新查看最新状态，到店时出示预约编号。'}}</view></view>
    <view class="panel"><view class="small muted">预约编号 · 建议复制保存</view><view class="order-number">{{booking.orderNo}}</view><button class="secondary wide" bindtap="copyOrder">复制预约编号</button><view class="divider" /><view class="title garment-title">{{booking.garmentName}}</view><view class="store-line">服装编号：{{booking.sku}}</view><view class="store-line">称呼：{{booking.guestName}} · {{booking.maskedPhone}}</view><view class="store-line">取衣：{{booking.startDate}}</view><view class="store-line">归还：{{booking.endDate}} {{settings.returnTime}} 前</view><view class="store-line">租期 {{booking.days}} 天，取还当日均计费</view><view class="divider" /><view class="row"><text>租金</text><text class="price">¥{{booking.rentalText}}</text></view><view class="row spaced"><text>押金另计</text><text>¥{{booking.depositText}}</text></view><view class="small muted spaced">到店支付租金和押金，本页面不收取款项。历史订单金额以预约时保存的价格为准。</view><view wx:if="{{booking.cancellationReason}}" class="error">取消说明：{{booking.cancellationReason}}</view></view>
    <view wx:if="{{error}}" class="error">{{error}}</view><button class="primary wide" bindtap="refresh" loading="{{loading}}" disabled="{{loading}}">刷新预约状态</button>
    <view class="panel spaced"><view class="title garment-title">到店取还</view><view class="store-line">地址：{{settings.address || '请提前与门店确认'}}</view><view class="store-line">营业时间：{{settings.hours || '请与店主确认'}}</view><view class="row spaced"><button wx:if="{{settings.phone}}" class="secondary" bindtap="callStore">联系门店</button><button wx:if="{{settings.wechat}}" class="secondary" bindtap="copyWechat">复制门店微信</button></view><view class="small muted spaced">需要调整日期或取消预约时，请联系门店处理。</view></view>
  </block>
  <button class="link wide spaced" bindtap="home">回首页继续挑选 ›</button>
</view>
