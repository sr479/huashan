.top-line { margin-bottom: 28rpx; }
.brand { font-size: 43rpx; font-weight: 600; letter-spacing: 7rpx; }
.hero { position: relative; border-radius: 24rpx; padding: 42rpx 34rpx; background: #e5ece7; overflow: hidden; margin-bottom: 24rpx; }
.hero-flower { position: absolute; right: -5rpx; top: 8rpx; color: #b7c9bd; font-size: 180rpx; line-height: 1; }
.hero-title { font-size: 47rpx; line-height: 1.5; position: relative; }
.hero-copy { font-size: 25rpx; color: #526b61; margin-top: 18rpx; max-width: 500rpx; }
.hero-tags { font-size: 21rpx; color: #627a6c; margin-top: 30rpx; }
.notice { border-left: 5rpx solid #bc7d5f; padding: 8rpx 20rpx; margin: 24rpx 0; color: #84684f; font-size: 25rpx; }
.section-heading { font-size: 29rpx; font-weight: 600; }
.search { background: #fff; }
.categories { width: 100%; margin: 20rpx 0; white-space: nowrap; }
.category-list { display: flex; gap: 14rpx; }
.category { flex-shrink: 0; padding: 13rpx 24rpx; font-size: 25rpx; background: #eeeee6; }
.category.active { background: #294e57; color: #fff; }
.demo-note { margin: 22rpx 0; color: #8b735b; }
.collection { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }
.garment-card { border: 1rpx solid #e6e4dc; border-radius: 17rpx; overflow: hidden; background: #fff; }
.card-photo { position: relative; height: 352rpx; }
.sku { position: absolute; bottom: 12rpx; left: 12rpx; font-size: 19rpx; padding: 3rpx 10rpx; background: rgba(255,255,255,.9); border-radius: 6rpx; }
.card-content { padding: 21rpx; }
.garment-name { font-weight: 600; font-size: 28rpx; line-height: 1.5; margin: 6rpx 0; min-height: 84rpx; }
.card-content .price { font-size: 35rpx; margin: 8rpx 0; }
.current-state { color: #7c8376; font-size: 22rpx; line-height: 1.6; margin-top: 16rpx; min-height: 71rpx; }
.card-link { color: #3c6564; font-size: 22rpx; border-top: 1rpx solid #eeece5; margin-top: 14rpx; padding-top: 12rpx; }
.guide { font-size: 25rpx; line-height: 2.1; color: #60776b; margin-top: 20rpx; }
.footer { font-size: 24rpx; text-align: center; color: #7c877c; padding: 20rpx; }
.footer view { font-size: 20rpx; margin-top: 4rpx; }
