:host { display: block; width: 100%; height: 100%; }
.photo { height: 100%; width: 100%; background: #dce3e3; overflow: hidden; }
.image { display: block; width: 100%; height: 100%; }
.placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #2c4a52; background: repeating-linear-gradient(45deg, transparent, transparent 28rpx, rgba(255,255,255,.16) 28rpx, rgba(255,255,255,.16) 30rpx); }
.motif { font-size: 96rpx; line-height: 1.3; opacity: .65; }
.name { font-size: 25rpx; text-align: center; padding: 12rpx; }
.hint { font-size: 20rpx; opacity: .7; }
.tone-red { background: #eddbd3; }
.tone-sage { background: #dde2d6; }
.tone-silver { background: #e2e1de; }
.tone-ochre { background: #eddfc4; }
.tone-teal { background: #cddfdb; }
