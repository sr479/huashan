# 合并到现有 Nginx 配置，证书路径以服务器实际位置为准。
# 先准备该域名的有效证书，再执行 nginx -t 和 reload。
server {
    listen 80;
    server_name huashanjie.top;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/huashanjie-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://huashanjie.top$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name huashanjie.top;
    ssl_certificate /etc/letsencrypt/live/huashanjie.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/huashanjie.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;
    access_log /var/log/nginx/huashanjie.access.log;
    error_log /var/log/nginx/huashanjie.error.log;

    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
